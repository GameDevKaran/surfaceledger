# Local server infers http://127.0.0.1:8784 when this is unset.
SURFACELEDGER_PUBLIC_ORIGIN=
# Set only to the exact clean release commit; local development can leave unset.
SURFACELEDGER_SOURCE_COMMIT=
# Deployment references only, never browser credentials.
AWS_PROFILE=clauserunner-dev
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
CLOUD_SPENDING_APPROVAL_REFERENCE=
# No AWS access key is needed by the stateless deployed runtime.
# Supporting GCP, if ever needed, is restricted to tough-melody-508008-p8.
# This application currently needs no GCP resource.
